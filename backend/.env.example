# Copy this file to .env and fill in your real key.
# .env is gitignored — never commit real secrets.

# Required — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional — override to route through an OpenAI-compatible endpoint (proxy/gateway).
# Leave unset to use the default https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional overrides (defaults shown)
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
